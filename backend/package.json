{
  "name": "bible-commentary-fr-tadros",
  "version": "1.0.0",
  "private": true,
  "description": "Public bilingual Bible commentary API for Fr. Tadros Y. Malaty",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build:db": "node scripts/build-db.js",
    "pretest": "node scripts/build-db.js --out test/.tmp/commentary.sqlite",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "morgan": "^1.10.0",
    "sanitize-html": "^2.13.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  }
}
